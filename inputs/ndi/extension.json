{
  "schema_version": 1,
  "name": "ndi-mxl-input",
  "version": "0.2.0",
  "kind": "input",
  "maturity": "prototype",
  "requires_core_api": "^1.0",
  "entrypoint": "ndi_input.py",
  "capabilities": ["ndi.receive", "mxl.video.publish", "mxl.audio.publish", "health.publish"],
  "flow_roles": {"reads": [], "publishes": ["source.video", "source.audio"]},
  "health": {"state_path": "/api/v1/state", "liveness_path": "/api/v1/health/live", "readiness_path": "/api/v1/health/ready", "bind_scope": "loopback"},
  "external_dependencies": ["NDI runtime and licensed SDK", "NDI Discovery Server when multicast discovery is unavailable"],
  "secret_refs": []
}
