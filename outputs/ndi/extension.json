{
  "schema_version": 1,
  "name": "program-ndi-output",
  "version": "0.1.0",
  "kind": "output",
  "maturity": "prototype",
  "requires_core_api": "^1.0",
  "entrypoint": "ndi_output.py",
  "capabilities": ["program.video.read", "program.audio.read", "ndi.send", "health.publish"],
  "flow_roles": {"reads": ["program.video", "program.audio"], "publishes": []},
  "health": {
    "state_path": "/api/v1/state",
    "liveness_path": "/api/v1/health/live",
    "readiness_path": "/api/v1/health/ready",
    "bind_scope": "loopback"
  },
  "external_dependencies": [
    "MXL GStreamer plugin",
    "GStreamer gst-plugin-ndi",
    "NDI runtime and licensed SDK"
  ],
  "secret_refs": []
}
