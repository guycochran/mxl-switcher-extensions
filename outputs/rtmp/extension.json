{
  "schema_version": 1,
  "name": "program-rtmps-output",
  "version": "0.3.1",
  "kind": "output",
  "maturity": "prototype",
  "requires_core_api": "^1.0",
  "entrypoint": "youtube_control.py",
  "capabilities": ["program.video.read", "program.audio.read", "rtmps.send", "health.publish"],
  "flow_roles": {"reads": ["program.video", "program.audio"], "publishes": []},
  "health": {
    "state_path": "/api/v1/state",
    "liveness_path": "/api/v1/health/live",
    "readiness_path": "/api/v1/health/ready",
    "bind_scope": "loopback"
  },
  "external_dependencies": ["GStreamer 1.24+", "gst-mxl-rs mxlsrc", "x264 CPU or NVENC H.264 encoder", "RTMPS sink"],
  "secret_refs": ["in-memory-rtmps-stream-key"]
}
